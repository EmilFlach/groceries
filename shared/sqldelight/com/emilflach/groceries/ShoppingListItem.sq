CREATE TABLE ShoppingListItem (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    lokcal_food_id INTEGER NOT NULL,
    name TEXT NOT NULL,
    image_url TEXT,
    added_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    checked_at TEXT
);

-- Prevents re-adding a food that's already active (unchecked) on the list.
CREATE UNIQUE INDEX IF NOT EXISTS shopping_list_item_active_food_idx
    ON ShoppingListItem(lokcal_food_id) WHERE checked_at IS NULL;

selectAll:
SELECT * FROM ShoppingListItem ORDER BY checked_at IS NOT NULL, added_at DESC;

selectActiveByFoodId:
SELECT * FROM ShoppingListItem WHERE lokcal_food_id = ? AND checked_at IS NULL;

insertItem:
INSERT INTO ShoppingListItem(lokcal_food_id, name, image_url) VALUES (?, ?, ?);

selectLastInsertRowId:
SELECT last_insert_rowid();

setChecked:
UPDATE ShoppingListItem SET checked_at = ? WHERE id = ?;

-- Checks off everything still "to buy" at once. Setting checked_at only removes rows from the
-- active-food unique index (which is partial on checked_at IS NULL), so it can't conflict.
checkAll:
UPDATE ShoppingListItem SET checked_at = ? WHERE checked_at IS NULL;

-- Restores checked items to the "to buy" section. Only the latest checked row per food is
-- revived, and only when no active row already holds that food, so the active-food unique
-- index above can't be violated (a food can be both checked and re-added as active).
uncheckAll:
UPDATE ShoppingListItem SET checked_at = NULL
WHERE id IN (
    SELECT MAX(id) FROM ShoppingListItem
    WHERE checked_at IS NOT NULL
      AND lokcal_food_id NOT IN (SELECT lokcal_food_id FROM ShoppingListItem WHERE checked_at IS NULL)
    GROUP BY lokcal_food_id
);

deleteById:
DELETE FROM ShoppingListItem WHERE id = ?;
